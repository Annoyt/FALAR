<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9–11 (minSdk 28). Здесь одно правило на облако и на перенос, поэтому всё включено только с
     requireFlags="deviceToDeviceTransfer": в облачную копию не попадает ничего, на новый телефон —
     всё, как раньше. Android 12+ читает data_extraction_rules.xml. -->
<full-backup-content>
  <include domain="root" path="." requireFlags="deviceToDeviceTransfer"/>
  <include domain="file" path="." requireFlags="deviceToDeviceTransfer"/>
  <include domain="database" path="." requireFlags="deviceToDeviceTransfer"/>
  <include domain="sharedpref" path="." requireFlags="deviceToDeviceTransfer"/>
  <include domain="external" path="." requireFlags="deviceToDeviceTransfer"/>
</full-backup-content>
