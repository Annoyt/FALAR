{"lang": "", "emotion": "", "event": "", "text": "Девушки любят обслуживаться.", "timestamps": [1.20, 1.36, 1.52, 1.60, 1.76, 1.84, 1.92, 2.08, 2.80, 2.88, 2.88, 2.96, 2.96, 2.96], "durations": [0.08, 0.16, 0.08, 0.16, 0.08, 0.08, 0.08, 0.08, 0.08, 0.00, 0.08, 0.00, 0.00, 0.00], "tokens":[" Де", "ву", "ш", "ки", " лю", "б", "ят", " об", "с", "лу", "жи", "ва", "ться", "."], "ys_log_probs": [-0.187086, -0.005226, -0.000091, -0.012733, -0.004713, -0.033204, -0.001702, -1.404521, -1.900922, -0.174807, -0.026137, -0.528426, -0.953552, -0.037879], "words": []}
