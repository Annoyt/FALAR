{"lang": "", "emotion": "", "event": "", "text": "Они не смогут тебя остановить.", "timestamps": [0.32, 0.56, 0.80, 0.96, 1.12, 1.28, 1.44, 1.60, 1.76, 2.00, 2.32, 2.48], "durations": [0.24, 0.24, 0.16, 0.16, 0.16, 0.16, 0.16, 0.16, 0.24, 0.16, 0.16, 0.08], "tokens":[" О", "ни", " не", " смо", "гу", "т", " те", "бя", " оста", "нови", "ть", "."], "ys_log_probs": [-0.000153, -0.000008, -0.000131, -0.000007, -0.000011, -0.000005, -0.000274, -0.000485, -0.000118, -0.000021, -0.000125, -0.004158], "words": []}
