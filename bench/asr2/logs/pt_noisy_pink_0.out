{"lang": "", "emotion": "", "event": "", "text": "Todos dizem que são inocentes.", "timestamps": [0.00, 0.32, 0.56, 0.72, 0.96, 1.12, 1.28, 1.44, 1.60, 2.00], "durations": [0.16, 0.24, 0.16, 0.08, 0.16, 0.16, 0.16, 0.16, 0.16, 0.08], "tokens":[" Tod", "os", " di", "zem", " que", " são", " in", "oc", "entes", "."], "ys_log_probs": [-0.197736, -0.001685, -0.002549, -0.002873, -0.000665, -0.000320, -0.000099, -0.000136, -0.035915, -0.060773], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "Eu não moro com o tom.", "timestamps": [0.16, 0.40, 0.56, 0.72, 0.88, 1.12, 1.28, 1.60], "durations": [0.24, 0.16, 0.16, 0.08, 0.08, 0.08, 0.08, 0.08], "tokens":[" Eu", " não", " mor", "o", " com", " o", " tom", "."], "ys_log_probs": [-0.054257, -0.000907, -0.021458, -0.005834, -0.223167, -0.290335, -0.828725, -0.685332], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "O Tom comeu três cachorros quentes.", "timestamps": [0.00, 0.40, 0.80, 0.96, 1.12, 1.20, 1.36, 1.52, 1.60, 1.84, 2.00, 2.24, 2.56], "durations": [0.16, 0.16, 0.08, 0.08, 0.08, 0.16, 0.16, 0.08, 0.24, 0.16, 0.24, 0.32, 0.08], "tokens":[" O", " Tom", " come", "u", " tr", "ês", " ca", "ch", "or", "ros", " qu", "entes", "."], "ys_log_probs": [-0.644829, -0.157656, -0.121513, -0.114302, -0.181351, -0.000096, -0.000143, -0.000002, -0.000030, -0.001471, -0.000142, -0.022066, -0.162682], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "Eu estava falando com vocês.", "timestamps": [0.16, 0.32, 0.72, 0.88, 1.04, 1.28, 1.52, 1.76], "durations": [0.16, 0.16, 0.16, 0.16, 0.24, 0.24, 0.24, 0.08], "tokens":[" Eu", " estava", " fal", "ando", " com", " você", "s", "."], "ys_log_probs": [-0.014760, -0.008862, -0.000032, -0.000003, -0.000511, -0.000047, -0.000263, -0.041779], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "Então assou seu nariz.", "timestamps": [0.16, 0.64, 0.96, 1.36, 1.60, 1.84, 2.40], "durations": [0.16, 0.16, 0.16, 0.08, 0.24, 0.24, 0.08], "tokens":[" Então", " ass", "ou", " seu", " nar", "iz", "."], "ys_log_probs": [-0.345417, -1.063598, -0.605310, -0.033782, -0.001132, -0.000028, -0.651936], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "Não é o carro de Tom.", "timestamps": [0.08, 0.32, 0.48, 0.56, 0.64, 0.80, 1.04, 1.36], "durations": [0.24, 0.16, 0.08, 0.08, 0.16, 0.08, 0.16, 0.08], "tokens":[" Não", " é", " o", " car", "ro", " de", " Tom", "."], "ys_log_probs": [-0.010432, -0.000577, -0.079674, -0.006680, -0.000717, -0.016688, -0.522280, -0.064525], "words": []}
