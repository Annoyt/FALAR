{"lang": "", "emotion": "", "event": "", "text": "Eu não moro com o tom.", "timestamps": [0.00, 0.32, 0.48, 0.72, 0.88, 1.04, 1.28, 1.68], "durations": [0.16, 0.16, 0.24, 0.16, 0.08, 0.08, 0.16, 0.08], "tokens":[" Eu", " não", " mor", "o", " com", " o", " tom", "."], "ys_log_probs": [-0.393304, -0.000378, -0.025529, -0.005845, -0.011371, -0.387323, -0.592496, -0.052835], "words": []}
