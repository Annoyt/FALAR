{"lang": "", "emotion": "", "event": "", "text": "Он покинул комнату, не сказал ни слова.", "timestamps": [0.00, 0.32, 0.48, 0.64, 0.80, 0.88, 0.96, 1.12, 1.20, 1.28, 1.44, 1.60, 1.76, 1.92, 2.16, 2.32], "durations": [0.32, 0.16, 0.16, 0.16, 0.08, 0.08, 0.16, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08, 0.16, 0.08], "tokens":[" Он", " по", "ки", "ну", "л", " ком", "на", "ту", ",", " не", " сказа", "л", " ни", " сло", "ва", "."], "ys_log_probs": [-0.006605, -0.006649, -0.004647, -0.000526, -0.013645, -0.001607, -0.013783, -0.237146, -0.270368, -0.022348, -0.013475, -0.414122, -0.081433, -0.262936, -0.041813, -0.128736], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "Вот почему девушки любят так сильно.", "timestamps": [0.24, 0.40, 0.64, 0.80, 0.96, 1.12, 1.28, 1.44, 1.52, 1.68, 1.84, 1.92, 2.16, 2.48, 2.72, 2.88], "durations": [0.16, 0.16, 0.16, 0.16, 0.16, 0.16, 0.16, 0.08, 0.16, 0.16, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08], "tokens":[" Во", "т", " по", "че", "му", " де", "ву", "ш", "ки", " лю", "б", "ят", " так", " си", "льно", "."], "ys_log_probs": [-0.202258, -0.022316, -0.006478, -0.001644, -0.000091, -0.001715, -0.014637, -0.000447, -0.018298, -0.004669, -0.011820, -0.000399, -1.195188, -1.185690, -0.249567, -0.257836], "words": []}
