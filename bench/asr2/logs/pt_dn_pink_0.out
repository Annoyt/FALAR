{"lang": "", "emotion": "", "event": "", "text": "Ela está contente com o seu sucesso.", "timestamps": [0.00, 0.16, 0.56, 0.72, 0.88, 0.96, 1.12, 1.28, 1.36, 1.68, 1.84, 2.00], "durations": [0.08, 0.08, 0.16, 0.16, 0.08, 0.16, 0.08, 0.08, 0.08, 0.16, 0.16, 0.08], "tokens":[" E", "la", " está", " con", "ten", "te", " com", " o", " seu", " suc", "esso", "."], "ys_log_probs": [-0.629117, -0.050911, -0.019297, -0.074317, -0.084319, -0.302402, -0.458942, -0.045822, -0.017708, -0.007913, -0.000007, -0.580054], "words": []}
