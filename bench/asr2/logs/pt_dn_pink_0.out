{"lang": "", "emotion": "", "event": "", "text": "Todos dias a gente são inocentes.", "timestamps": [0.16, 0.32, 0.56, 0.64, 0.80, 0.88, 0.96, 1.12, 1.36, 1.44, 1.60, 1.84], "durations": [0.16, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08, 0.16, 0.16, 0.08], "tokens":[" Tod", "os", " di", "as", " a", " g", "ente", " são", " in", "oc", "entes", "."], "ys_log_probs": [-0.149393, -0.020028, -0.066977, -0.021827, -0.235406, -0.156376, -0.012219, -0.012009, -0.002202, -0.001799, -0.355497, -0.359330], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "Eu não moro com o tom.", "timestamps": [0.16, 0.40, 0.56, 0.72, 0.88, 1.12, 1.28, 1.60], "durations": [0.08, 0.16, 0.16, 0.08, 0.08, 0.08, 0.08, 0.08], "tokens":[" Eu", " não", " mor", "o", " com", " o", " tom", "."], "ys_log_probs": [-0.106678, -0.005357, -0.036510, -0.066868, -0.446497, -0.426905, -0.861433, -0.194308], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "O Tom come três cachorros quentes.", "timestamps": [0.16, 0.32, 0.72, 1.04, 1.12, 1.28, 1.44, 1.60, 1.76, 2.00, 2.16, 2.48], "durations": [0.16, 0.16, 0.08, 0.08, 0.16, 0.16, 0.16, 0.16, 0.24, 0.16, 0.16, 0.08], "tokens":[" O", " Tom", " come", " tr", "ês", " ca", "ch", "or", "ros", " qu", "entes", "."], "ys_log_probs": [-0.068380, -0.296287, -0.326066, -0.126071, -0.000113, -0.000700, -0.000152, -0.000824, -0.020579, -0.007960, -0.116641, -0.129100], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "Eu estava falando com vocês.", "timestamps": [0.16, 0.32, 0.72, 0.88, 1.04, 1.28, 1.52, 1.68], "durations": [0.16, 0.16, 0.16, 0.16, 0.24, 0.24, 0.16, 0.08], "tokens":[" Eu", " estava", " fal", "ando", " com", " você", "s", "."], "ys_log_probs": [-0.006923, -0.002979, -0.000109, -0.000017, -0.000830, -0.000240, -0.000271, -0.027531], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "Então seu nariz.", "timestamps": [0.16, 1.36, 1.60, 1.84, 2.16], "durations": [0.08, 0.08, 0.08, 0.16, 0.24], "tokens":[" Então", " seu", " nar", "iz", "."], "ys_log_probs": [-0.838866, -0.856761, -1.078658, -0.082047, -0.372531], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "Não é o que eu te coloco.", "timestamps": [0.08, 0.24, 0.40, 0.48, 0.64, 0.96, 1.12, 1.20, 1.36, 1.36], "durations": [0.16, 0.16, 0.08, 0.08, 0.08, 0.08, 0.08, 0.16, 0.00, 0.08], "tokens":[" Não", " é", " o", " que", " eu", " te", " c", "olo", "co", "."], "ys_log_probs": [-0.044597, -0.008237, -0.047724, -0.990169, -0.769226, -1.268118, -1.826588, -0.327590, -0.144762, -0.016553], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "And also something looking.", "timestamps": [0.16, 0.40, 0.72, 0.80, 1.12, 1.28, 1.92], "durations": [0.08, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08], "tokens":[" And", " also", " somet", "hing", " look", "ing", "."], "ys_log_probs": [-1.524157, -1.013586, -0.571346, -0.204363, -1.636310, -0.204520, -0.766557], "words": []}
