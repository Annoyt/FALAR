{"lang": "", "emotion": "", "event": "", "text": "Todos dizem que são inocentes.", "timestamps": [0.00, 0.32, 0.56, 0.72, 0.96, 1.12, 1.28, 1.44, 1.60, 2.00], "durations": [0.16, 0.24, 0.16, 0.16, 0.16, 0.16, 0.16, 0.16, 0.16, 0.08], "tokens":[" Tod", "os", " di", "zem", " que", " são", " in", "oc", "entes", "."], "ys_log_probs": [-0.206874, -0.001552, -0.002851, -0.000539, -0.000022, -0.000112, -0.000063, -0.000211, -0.025351, -0.045733], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "Eu não moro com o Tom.", "timestamps": [0.00, 0.32, 0.56, 0.72, 0.88, 1.04, 1.20, 1.68], "durations": [0.16, 0.24, 0.16, 0.16, 0.08, 0.08, 0.16, 0.08], "tokens":[" Eu", " não", " mor", "o", " com", " o", " Tom", "."], "ys_log_probs": [-0.172922, -0.000096, -0.005134, -0.000585, -0.036780, -0.162289, -0.508844, -0.036120], "words": []}
{"lang": "", "emotion": "", "event": "", "text": "O Tom comeu três cachorros quentes.", "timestamps": [0.00, 0.40, 0.72, 0.96, 1.12, 1.20, 1.36, 1.52, 1.60, 1.84, 2.00, 2.24, 2.56], "durations": [0.16, 0.16, 0.24, 0.16, 0.08, 0.16, 0.16, 0.08, 0.24, 0.16, 0.24, 0.32, 0.08], "tokens":[" O", " Tom", " come", "u", " tr", "ês", " ca", "ch", "or", "ros", " qu", "entes", "."], "ys_log_probs": [-0.221803, -0.120408, -0.016122, -0.004288, -0.220350, -0.000049, -0.000050, -0.000001, -0.000010, -0.000163, -0.000008, -0.008496, -0.096269], "words": []}
