 // ---------------------------------------------------------------------------
+// InvolvesInt16Quant (Falar patch) — Q with INT16 output, DQ with INT16 input, or a QDQ group whose
+// quantized inputs/output are INT16.
+// ---------------------------------------------------------------------------
+bool BaseOpBuilder::InvolvesInt16Quant(const onnx::NodeProto& node, const NeuronGraphContext& ctx) {
+  const auto is16 = [](int32_t t) { return t == onnx::TensorProto::INT16; };
+  if (node.op_type() == "QuantizeLinear" && node.output_size() > 0)
+    return is16(ctx.GetElementType(node.output(0)));
+  if (node.op_type() == "DequantizeLinear" && node.input_size() > 0)
+    return is16(ctx.GetElementType(node.input(0)));
+  if (node.output_size() == 0 || node.output(0).empty()) return false;
+  const QDQNodeGroup* g = ctx.GetQDQGroup(node.output(0));
+  if (!g) return false;
+  for (const auto& q : g->input_quant_params)
+    if (q.has_value() && is16(q->quant_type)) return true;
+  return g->output_quant_params.has_value() && is16(g->output_quant_params->quant_type);
+}
