// Конфиг Worker бота. bot/cf.sh deploy собирает из него wrangler.jsonc (не в git), подставляя номер
// базы D1 из ~/.config/falar/bot.env. Секреты Worker — BOT_TOKEN, WEBHOOK_SECRET, OWNER, GITHUB_TOKEN — ставит
// тот же скрипт (`wrangler secret bulk` из stdin), здесь их нет.
{
  "name": "falar-feedback-bot",
  "main": "cf/worker.js",
  "compatibility_date": "2026-09-01",
  // Модули бота импортируют друг друга голыми именами, как требует Telegram Serverless: код тот же.
  "alias": {
    "sdk": "./cf/sdk.js",
    "lib/owner": "./lib/owner.js",
    "lib/feedback": "./lib/feedback.js",
    "lib/store": "./lib/store.js",
    "handlers/message": "./handlers/message.js",
    "handlers/callback_query": "./handlers/callback_query.js",
    "lib/stats": "./lib/stats.js",
    "lib/topics": "./lib/topics.js",
    "lib/telemetry": "./lib/telemetry.js",
    "handlers/scheduled": "./handlers/scheduled.js",
    "handlers/telemetry": "./handlers/telemetry.js"
  },
  // Раз в час, в :05 — handlers/scheduled: сводка скачиваний с GitHub раз в сутки.
  "triggers": { "crons": ["5 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "falar-feedback", "database_id": "__D1_ID__" }
  ],
  // Журнал вызовов (запрос с адресом и заголовками) не пишем: приложение шлёт сюда статистику и звук по
  // согласию людей, и адрес мы обещали не хранить. Свои console.log/console.error бота остаются.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
